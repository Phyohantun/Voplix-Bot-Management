# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption Key (32 bytes hex encoded - generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-encryption-key-64-characters-hex

# Redis/Upstash Configuration
UPSTASH_REDIS_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# Application URL (also used for redirects when NEXT_PUBLIC_SITE_URL is unset)
NEXT_PUBLIC_APP_URL=https://app.ismecy.com
# Optional: canonical site URL for auth redirects
# NEXT_PUBLIC_SITE_URL=https://app.ismecy.com

# Platform admin (separate from Supabase user accounts; protects /admin and /api/admin/*)
# PLATFORM_ADMIN_EMAIL=you@example.com
# Admin password bcrypt (generate: node scripts/hash-platform-admin-password.mjs 'your-password')
# Prefer the printed b64: line — no $ characters, avoids .env mangling.
# PLATFORM_ADMIN_PASSWORD_HASH=b64:<paste_full_line_from_script>
# Random secret, min 32 characters (e.g. openssl rand -base64 32)
# PLATFORM_ADMIN_JWT_SECRET=
